{
  "title": "Logitech MX Keys Mini top row: loft fan, Spotify volume, Spotify play/pause",
  "rules": [
    {
      "description": "Loft fan: the F6 key (two quick Ctrl taps) toggles it (loft-fan)",
      "manipulators": [
        {
          "type": "basic",
          "conditions": [
            {
              "type": "variable_if",
              "name": "loft_ctrl_tapped",
              "value": 1
            }
          ],
          "from": {
            "key_code": "left_control",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "set_variable": {
                "name": "loft_ctrl_tapped",
                "value": 0
              }
            },
            {
              "shell_command": "/bin/sh -c 'date >> /tmp/loft-fan-key.log; /Users/fredrikbranstrom/.local/bin/loft-fan toggle >> /tmp/loft-fan-key.log 2>&1'"
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "left_control",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "set_variable": {
                "name": "loft_ctrl_tapped",
                "value": 1
              }
            },
            {
              "key_code": "left_control"
            }
          ],
          "to_delayed_action": {
            "to_if_invoked": [
              {
                "set_variable": {
                  "name": "loft_ctrl_tapped",
                  "value": 0
                }
              }
            ],
            "to_if_canceled": [
              {
                "set_variable": {
                  "name": "loft_ctrl_tapped",
                  "value": 0
                }
              }
            ]
          },
          "parameters": {
            "basic.to_delayed_action_delay_milliseconds": 250
          }
        }
      ]
    },
    {
      "description": "Spotify volume: the volume keys step it by 5 (spotify-volume)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "consumer_key_code": "volume_increment"
          },
          "to": [
            {
              "shell_command": "/Users/fredrikbranstrom/.local/bin/spotify-volume up"
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "consumer_key_code": "volume_decrement"
          },
          "to": [
            {
              "shell_command": "/Users/fredrikbranstrom/.local/bin/spotify-volume down"
            }
          ]
        }
      ]
    },
    {
      "description": "Spotify play/pause: the play/pause key controls only Spotify (spotify-playpause)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "consumer_key_code": "play_or_pause"
          },
          "to": [
            {
              "shell_command": "/Users/fredrikbranstrom/.local/bin/spotify-playpause"
            }
          ]
        }
      ]
    }
  ]
}